// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  MEDIATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MediationRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MediationType {
  LEASE
  PURCHASE_SALE
  PROPERTY_DELIVERY
  CONTRACT_BREACH
  NEIGHBOR_CONFLICT
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum CaseStatus {
  OPEN
  INFORMATION_PENDING
  SESSION_SCHEDULED
  IN_MEDIATION
  AGREEMENT_DRAFTING
  AWAITING_SIGNATURES
  SIGNED
  REGISTRATION_PENDING
  CLOSED_SUCCESS
  CLOSED_NO_AGREEMENT
  CANCELLED
}

enum CaseParticipantRole {
  REQUESTING_PARTY
  INVITED_PARTY
  MEDIATOR
  LEGAL_REPRESENTATIVE
  LAWYER
  OBSERVER
}

enum SessionModality {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum SessionStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum CaseInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CaseDocumentType {
  IDENTIFICATION
  PROPERTY_DOCUMENT
  CONTRACT
  REQUEST
  EVIDENCE
  AGREEMENT_DRAFT
  SIGNED_AGREEMENT
  REGISTRATION_PROOF
  PAYMENT_RECEIPT
  OTHER
}

enum CaseDocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum NotificationType {
  CASE_STATUS_CHANGED
  SESSION_CREATED
  SESSION_RESCHEDULED
  SESSION_STATUS_CHANGED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  INVITATION_REJECTED
  DOCUMENT_CREATED
  DOCUMENT_VERSION_CREATED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
  DOCUMENT_DELETED
  GENERAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role       @default(CLIENT)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  refreshTokens RefreshToken[]
  notifications Notification[]
  pushTokens    PushToken[]

  clientRequests       MediationRequest[]     @relation("ClientRequests")
  assignedRequests     MediationRequest[]     @relation("MediatorRequests")
  requestStatusChanges RequestStatusHistory[] @relation("RequestStatusChanges")
  scheduledSessions    MediationSession[]     @relation("SessionCreatedBy")

  clientCases       MediationCase[]     @relation("ClientCases")
  mediatorCases     MediationCase[]     @relation("MediatorCases")
  caseParticipants  CaseParticipant[]
  caseStatusChanges CaseStatusHistory[] @relation("CaseStatusChanges")

  createdCaseInvitations  CaseInvitation[] @relation("CaseInvitationCreatedBy")
  acceptedCaseInvitations CaseInvitation[] @relation("CaseInvitationAcceptedBy")

  uploadedCaseDocuments    CaseDocument[]        @relation("CaseDocumentUploadedBy")
  uploadedDocumentVersions CaseDocumentVersion[] @relation("DocumentVersionUploadedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model MediationRequest {
  id          String                 @id @default(uuid())
  folio       String                 @unique
  title       String
  description String
  type        MediationType
  urgency     UrgencyLevel           @default(MEDIUM)
  status      MediationRequestStatus @default(DRAFT)

  clientId           String
  assignedMediatorId String?

  submittedAt DateTime?
  reviewedAt  DateTime?
  decisionAt  DateTime?

  rejectionReason String?

  case MediationCase?

  client User @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Restrict)

  assignedMediator User? @relation("MediatorRequests", fields: [assignedMediatorId], references: [id], onDelete: SetNull)

  statusHistory RequestStatusHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([assignedMediatorId])
  @@index([status])
  @@index([createdAt])
  @@map("mediation_requests")
}

model RequestStatusHistory {
  id String @id @default(uuid())

  requestId   String
  changedById String

  fromStatus MediationRequestStatus?
  toStatus   MediationRequestStatus

  comment String?

  request MediationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  changedBy User @relation("RequestStatusChanges", fields: [changedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([changedById])
  @@index([createdAt])
  @@map("request_status_history")
}

model MediationCase {
  id          String     @id @default(uuid())
  folio       String     @unique
  title       String
  description String
  status      CaseStatus @default(OPEN)

  requestId  String @unique
  clientId   String
  mediatorId String

  openedAt DateTime  @default(now())
  closedAt DateTime?

  request MediationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  client User @relation("ClientCases", fields: [clientId], references: [id], onDelete: Restrict)

  mediator User @relation("MediatorCases", fields: [mediatorId], references: [id], onDelete: Restrict)

  participants  CaseParticipant[]
  statusHistory CaseStatusHistory[]
  sessions      MediationSession[]
  invitations   CaseInvitation[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  caseDocuments CaseDocument[]

  @@index([clientId])
  @@index([mediatorId])
  @@index([status])
  @@index([createdAt])
  @@map("mediation_cases")
}

model CaseParticipant {
  id String @id @default(uuid())

  caseId String
  userId String?

  role CaseParticipantRole

  firstName String
  lastName  String
  email     String?
  phone     String?

  invitedAt  DateTime?
  acceptedAt DateTime?

  mediationCase MediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([userId])
  @@map("case_participants")
}

model CaseStatusHistory {
  id String @id @default(uuid())

  caseId      String
  changedById String

  fromStatus CaseStatus?
  toStatus   CaseStatus

  comment String?

  mediationCase MediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  changedBy User @relation("CaseStatusChanges", fields: [changedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([changedById])
  @@index([createdAt])
  @@map("case_status_history")
}

model MediationSession {
  id String @id @default(uuid())

  caseId      String
  createdById String

  title       String
  description String?

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  modality SessionModality
  status   SessionStatus   @default(SCHEDULED)

  location   String?
  meetingUrl String?

  notes String?

  mediationCase MediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdBy User @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([caseId])
  @@index([createdById])
  @@index([scheduledAt])
  @@index([status])
  @@map("mediation_sessions")
}

model CaseInvitation {
  id String @id @default(uuid())

  caseId       String
  invitedById  String
  acceptedById String?

  email     String
  firstName String
  lastName  String
  phone     String?

  participantRole CaseParticipantRole  @default(INVITED_PARTY)
  status          CaseInvitationStatus @default(PENDING)

  token     String   @unique
  expiresAt DateTime

  acceptedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  mediationCase MediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  invitedBy User @relation("CaseInvitationCreatedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  acceptedBy User? @relation("CaseInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([email])
  @@index([status])
  @@index([participantRole])
  @@index([expiresAt])
  @@map("case_invitations")
}

model CaseDocument {
  id String @id @default(uuid())

  caseId       String
  uploadedById String

  name        String
  description String?
  type        CaseDocumentType
  status      CaseDocumentStatus @default(ACTIVE)

  currentVersion Int @default(1)

  mediationCase MediationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  uploadedBy User @relation("CaseDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  versions CaseDocumentVersion[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@index([caseId])
  @@index([uploadedById])
  @@index([type])
  @@index([status])
  @@map("case_documents")
}

model CaseDocumentVersion {
  id String @id @default(uuid())

  documentId   String
  uploadedById String

  versionNumber Int

  originalName String
  storedName   String
  storagePath  String
  mimeType     String
  sizeBytes    Int

  checksum String?
  notes    String?

  document CaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  uploadedBy User @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
  @@map("case_document_versions")
}

model Notification {
  id String @id @default(uuid())

  userId String

  type   NotificationType
  status NotificationStatus @default(UNREAD)

  title   String
  message String

  caseId       String?
  sessionId    String?
  invitationId String?
  documentId   String?

  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  readAt     DateTime?
  archivedAt DateTime?

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@index([caseId])
  @@map("notifications")
}

model PushToken {
  id String @id @default(uuid())

  userId String

  token    String  @unique
  platform String
  deviceId String?

  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@map("push_tokens")
}
